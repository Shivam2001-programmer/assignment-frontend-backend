NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://leads:leads@localhost:5433/leads?schema=public
CORS_ORIGIN=http://localhost:5173

# Meta webhook
META_APP_SECRET=local-dev-app-secret
META_VERIFY_TOKEN=local-dev-verify-token
# Optional — enables fetching lead details from the Graph API when a webhook only carries leadgen_id
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0
WEBHOOK_RATE_LIMIT_PER_MIN=300
